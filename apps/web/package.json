{
  "private": true,
  "name": "@isyuricunha/web-sveltekit",
  "version": "0.0.0",
  "description": "SvelteKit implementation of yuricunha.com (migration target)",
  "license": "AGPL-3.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 dotenv -e ../../.env.local -- vite dev --port 3010",
    "build": "dotenv -e ../../.env.local -- vite build",
    "build:mdx": "svelte-kit sync && content-collections build",
    "preview": "dotenv -e ../../.env.local -- vite preview --port 3010",
    "check": "content-collections build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "type-check": "content-collections build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "dotenv -e ../../.env.local -- vitest run --config vitest.config.ts",
    "test:trpc": "dotenv -e ../../.env.local -- vitest run --config vitest.trpc.config.ts"
  },
  "devDependencies": {

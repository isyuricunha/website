{
  "private": true,
  "name": "@isyuricunha/web-sveltekit",
  "version": "0.0.0",
  "description": "SvelteKit implementation of yuricunha.com (migration target)",
  "license": "AGPL-3.0",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- vite dev --port 3010",
    "build": "dotenv -e ../../.env.local -- vite build",
    "build:mdx": "content-collections build",
    "preview": "dotenv -e ../../.env.local -- vite preview --port 3010",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "type-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@content-collections/cli": "^0.1.9",
    "@content-collections/core": "^0.15.3",
    "@content-collections/vite": "^0.3.1",
    "@isyuricunha/i18n": "workspace:*",
    "@isyuricunha/mdx-plugins": "workspace:*",
    "@isyuricunha/mdx-render": "workspace:*",
    "@isyuricunha/trpc-server": "workspace:*",
    "@isyuricunha/tsconfig": "workspace:*",
    "@mdx-js/mdx": "^3.1.1",
    "@sveltejs/adapter-vercel": "^7.0.3",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "better-auth": "1.7.7",
    "dotenv-cli": "^11.0.0",
    "superjson": "^2.2.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "zod": "^4.6.5"
  }
}

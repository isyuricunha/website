{
  "private": true,
  "name": "@isyuricunha/docs-sveltekit",
  "version": "0.0.0",
  "description": "SvelteKit implementation of docs.yuricunha.com (migration target)",
  "license": "AGPL-3.0",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/site.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --port 3011",
    "build": "vite build",
    "build:mdx": "svelte-kit sync && content-collections build",
    "preview": "vite preview --port 3011",
    "check": "content-collections build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "type-check": "content-collections build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@content-collections/cli": "^0.1.9",
    "@content-collections/core": "^0.15.3",
    "@content-collections/vite": "^0.3.1",
    "@hookform/resolvers": "^5.9.1",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@isyuricunha/mdx-plugins": "workspace:*",
    "@isyuricunha/mdx-render": "workspace:*",
    "@isyuricunha/tsconfig": "workspace:*",
    "@isyuricunha/utils": "workspace:*",
    "@isyuricunha/yutheme": "^0.2.1",
    "@mdx-js/mdx": "^3.1.1",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "shiki": "^4.5.0",
    "zod": "^4.6.5",
    "@sveltejs/adapter-vercel": "^7.0.3",
    "@tanstack/react-table": "^8.21.3",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  }
}
